# Agora credentials
# Required: found in Agora Console → your project → "App ID"
NEXT_PUBLIC_AGORA_APP_ID=

# Required: found in Agora Console → your project → "App Certificate"
# Server-side only. Never expose this in client code.
NEXT_AGORA_APP_CERTIFICATE=

# Required for Diwali Dost speech synthesis. Server-side only.
SMALLEST_API_KEY=

# Public HTTPS origin for Agora cloud to call the local festival API.
# Deploy this app or expose it through an HTTPS tunnel; localhost is unreachable.
AGENT_TOOL_BASE_URL=
